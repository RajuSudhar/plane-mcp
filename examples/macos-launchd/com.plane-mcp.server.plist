<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>              <string>com.plane-mcp.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SERVE_SH__</string>
  </array>
  <key>RunAtLoad</key>          <true/>
  <key>KeepAlive</key>          <true/>
  <key>ThrottleInterval</key>   <integer>10</integer>
  <key>ProcessType</key>        <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>                   <string>__HOME__</string>
    <key>PLANE_MCP_INSTANCE</key>     <string>__INSTANCE__</string>
    <key>PLANE_WORKSPACE_SLUG</key>   <string>__WORKSPACE__</string>
    <key>PLANE_BASE_URL</key>         <string>__BASE_URL__</string>
    <key>PORT</key>                   <string>__PORT__</string>
  </dict>
  <key>StandardOutPath</key>    <string>__HOME__/Library/Logs/plane-mcp.out.log</string>
  <key>StandardErrorPath</key>  <string>__HOME__/Library/Logs/plane-mcp.err.log</string>
</dict>
</plist>
