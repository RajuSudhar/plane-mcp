{
  "name": "plane-mcp",
  "version": "2.0.0-beta.0",
  "description": "MCP server for Plane (open-source Jira-like ticketing) — stdio + streamable-HTTP transports, Bun + TypeScript 7.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "plane",
    "bun",
    "typescript"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RajuSudhar/plane-mcp.git"
  },
  "bin": {
    "plane-mcp": "./src/stdio.ts",
    "plane-mcp-http": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "bun run src/index.ts",
    "start:stdio": "bun run src/stdio.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun run format:check && bun run lint",
    "prepare": "git config core.hooksPath .githooks || true",
    "prepublishOnly": "bun run typecheck && bun run check && bun test",
    "generate:config-schema": "bun run scripts/generate-config-schema.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/hono": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "gpt-tokenizer": "4.0.0",
    "hono": "4.6.14",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
