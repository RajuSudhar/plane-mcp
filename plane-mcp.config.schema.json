{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "plane-mcp server config",
  "description": "Validated behavior config for plane-mcp: per-tool output-token limits. See https://github.com/RajuSudhar/plane-mcp for discovery order and defaults.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "properties": {
        "maxOutputTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "maxOutputTokens": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
