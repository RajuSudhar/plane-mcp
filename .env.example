# Plane API Personal or Workspace Access Token (required)
# Generate at: Plane → Profile Settings → Personal Access Tokens
# or: Workspace Settings → Access Tokens (for bot token)
PLANE_API_KEY=

# Workspace identifier, e.g., 'my-workspace' (required)
PLANE_WORKSPACE_SLUG=

# Plane API base URL (optional, defaults to https://api.plane.so)
# Must use https
PLANE_BASE_URL=https://api.plane.so

# Server port (optional, defaults to 3000)
# Valid range: 1-65535
PORT=3000

# Optional: absolute path to a behavior config file (per-tool output-token
# limits). See README.md "Configure per-tool output-token limits" for the
# full discovery order and config shape. Unset by default — zero config
# required.
# PLANE_MCP_CONFIG=

# Optional: override the default per-tool output-token limit (default: 25000)
# PLANE_MCP_MAX_OUTPUT_TOKENS=25000
