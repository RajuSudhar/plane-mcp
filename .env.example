# Plane API Personal or Workspace Access Token (required)
# Generate at: Plane → Profile Settings → Personal Access Tokens
# or: Workspace Settings → Access Tokens (for bot token)
PLANE_API_KEY=

# Workspace identifier, e.g., 'my-workspace' (required)
PLANE_WORKSPACE_SLUG=

# Plane API base URL (optional, defaults to https://api.plane.so)
# Must use https
PLANE_BASE_URL=https://api.plane.so

# Server port (optional, defaults to 3000)
# Valid range: 1-65535
PORT=3000
